# ==============================================================================
# Veil402 (CoinCeylon/zk-turnover) — Environment Configuration Template
# Copy to `.env` locally. NEVER commit `.env`, API keys, or wallet seed phrases.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zero-Wait Switchboard Flags ("mock" | "live")
#    Keep other tracks on "mock" while developing your own track independently.
# ------------------------------------------------------------------------------
GATEWAY_MODE=mock
MIDNIGHT_MODE=mock
CARDANO_MODE=mock

# Frontend public switch (mirrors GATEWAY_MODE for browser code)
NEXT_PUBLIC_GATEWAY_MODE=mock
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. API Gateway & AI Agent Demo (Member 1)
# ------------------------------------------------------------------------------
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Optional: plug in an LLM key for the AI Research Assistant demo; falls back to deterministic synthesis when empty
AI_AGENT_API_KEY=

# ------------------------------------------------------------------------------
# 3. Midnight Privacy & ZK Proof Server (Member 2)
# ------------------------------------------------------------------------------
MIDNIGHT_NETWORK=testnet
MIDNIGHT_PROOF_SERVER_IMAGE=midnightnetwork/proof-server:latest
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_INDEXER_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_ACCESS_GATE_CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# 4. Cardano Preprod & Aiken Settlement (Member 3)
# ------------------------------------------------------------------------------
CARDANO_NETWORK=preprod
CARDANO_DATA_PROVIDER=blockfrost
BLOCKFROST_PREPROD_API_KEY=
KOIOS_PREPROD_URL=https://preprod.koios.rest/api/v1
CARDANO_SLA_VAULT_SCRIPT_ADDRESS=
CARDANO_PROTOCOL_TREASURY_ADDRESS=
